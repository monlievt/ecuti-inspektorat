##############################################################################
# .env.production.example
# Template konfigurasi production untuk server Virtualmin / VPS
#
# CARA PAKAI:
# 1. Salin file ini: cp .env.production.example .env
# 2. Isi semua nilai bertanda <GANTI_INI>
# 3. Jangan pernah commit file .env ke repository!
##############################################################################

APP_NAME="e-Cuti Inspektorat"
APP_ENV=production
APP_KEY=<GENERATE_DENGAN: php artisan key:generate --show>
APP_DEBUG=false
APP_FORCE_HTTPS=true
APP_URL=https://ecuti.trenggalekkab.go.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

# Naikkan BCrypt rounds untuk memperlambat brute-force di production
BCRYPT_ROUNDS=14

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Database MySQL (Virtualmin biasanya menggunakan user per-domain) ─────────
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<NAMA_DATABASE>
DB_USERNAME=<DB_USER>
DB_PASSWORD=<PASSWORD_KUAT_MIN_20_KARAKTER>

# ── Session ──────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=ecuti.trenggalekkab.go.id
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ── Cache ────────────────────────────────────────────────────────────────────
CACHE_STORE=file

# ── Queue ────────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=database

# ── Mail ─────────────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=smtp
MAIL_HOST=<SMTP_HOST>
MAIL_PORT=587
MAIL_USERNAME=<EMAIL_PENGIRIM>
MAIL_PASSWORD=<PASSWORD_EMAIL>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="ecuti@inspektorat.trenggalekkab.go.id"
MAIL_FROM_NAME="${APP_NAME}"

# ── WhatsApp via WAHA ─────────────────────────────────────────────────────────
WAHA_BASE_URL=http://localhost:3000
WAHA_SESSION=ecuti

# ── Google reCAPTCHA v2 (kosongkan untuk Math Captcha offline) ───────────────
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

VITE_APP_NAME="${APP_NAME}"
